{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "fa43aec1-d40d-4c5d-8572-31bfeacea28a",
   "metadata": {},
   "source": [
    "# Reglas de AgrupaciÃ³n de Datos NumÃ©ricos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ba4b8dc3-e0c0-44e4-8c56-8c15be16aec6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "13eff5d1-602c-4b3c-a8ff-a63ac6769cda",
   "metadata": {},
   "outputs": [],
   "source": [
    "def raiz(data):\n",
    "    n = len(data)\n",
    "    k1 = int(np.ceil(np.sqrt(n)))    \n",
    "    return k1\n",
    "\n",
    "def sturges(data):\n",
    "    n = len(data)\n",
    "    k2 = int(np.ceil(1 + np.log2(n)))\n",
    "    return k2\n",
    "\n",
    "def scott(data):\n",
    "    n = len(data)\n",
    "    As = 3.5*np.std(data)*n**(-1/3)\n",
    "    k3 = int(np.ceil((max(data)-min(data))/As))\n",
    "    return k3\n",
    "\n",
    "def freedman_diaconis(data):\n",
    "    n = len(data)\n",
    "    irq = np.percentile(data, 75) - np.percentile(data, 25)\n",
    "    Afd = 2 * irq * np.power(n, -1/3)\n",
    "    k4 = int(np.ceil((max(data)-min(data) / Afd)))\n",
    "    return k4"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eb74b098-165e-446c-aa0b-65acb1e8557e",
   "metadata": {},
   "source": [
    "Cargamos el dataset:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "58a149dc-0aff-4f73-8449-3f0b79171eae",
   "metadata": {},
   "outputs": [],
   "source": [
    "crabs = pd.read_table(\"../../data/datacrab.txt\", sep = \" \")\n",
    "cw = np.array(crabs[\"width\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50e81a60-7190-4cbe-a8f8-1c2a7c48a415",
   "metadata": {},
   "source": [
    "## Pregunta 1"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "26017a1b-1341-4d7b-baf5-7d2328f65f64",
   "metadata": {},
   "source": [
    "Da el algoritmo para reproducir el proceso de generaciÃ³n de clases y sus marcas donde el nÃºmero de clases ha sido obtenido con la regla de la Scott en `Python`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ebf5b80a-3efd-4b6d-a7e0-be896e9d10f8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "La amplitud es 1.2\n",
      "Los intervalos son: [20.95 22.15 23.35 24.55 25.75 26.95 28.15 29.35 30.55 31.75 32.95]\n",
      "Las marcas son: [21.55 22.75 23.95 25.15 26.35 27.55 28.75 29.95 31.15 32.35]\n"
     ]
    }
   ],
   "source": [
    "# CÃ¡lculo de la amplitud\n",
    "A = round((max(cw)-min(cw))/scott(cw), 1)\n",
    "\n",
    "print(\"La amplitud es {}\".format(A))\n",
    "\n",
    "# Extremos de los intervalos\n",
    "L = np.zeros(scott(cw) + 1)\n",
    "L[0] = min(cw) - 1 / 2 * 0.1\n",
    "for i in range(1, scott(cw) + 1):\n",
    "    L[i] = L[0] + i * A\n",
    "\n",
    "print(\"Los intervalos son: {}\".format(L))\n",
    "# Marcas de clase\n",
    "\n",
    "X = np.zeros(scott(cw))\n",
    "X[0] = (L[0] + L[1])/2\n",
    "for i in range(1, scott(cw)):\n",
    "    X[i] = (L[i] + L[i+1])/2\n",
    "    \n",
    "print(\"Las marcas son: {}\".format(X))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "efdb3263-d1b8-4f07-9c88-3c952b13604a",
   "metadata": {},
   "source": [
    "## Pregunta 2"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ae85d999-e447-478b-9004-421773bbd045",
   "metadata": {},
   "source": [
    "Da el algoritmo para reproducir el proceso de generaciÃ³n de clases y sus marcas donde el nÃºmero de clases ha sido obtenido con la regla de la raÃ­z en `Python`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "645a9108-1037-41dc-bc01-dabece9811cf",
