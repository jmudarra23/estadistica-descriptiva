   "metadata": {},
   "source": [
    "Da el algoritmo para reproducir el proceso de generaciÃ³n de clases y sus marcas donde el nÃºmero de clases ha sido obtenido con la regla de la Freedman-Diaconis en `Python`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "db5b561d-41d6-4f50-9e2a-beed9d4da3ff",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "La amplitud es 1.0\n",
      "Los intervalos son: [20.95 21.95 22.95 23.95 24.95 25.95 26.95 27.95 28.95 29.95 30.95 31.95\n",
      " 32.95 33.95]\n",
      "Las marcas son: [21.45 22.45 23.45 24.45 25.45 26.45 27.45 28.45 29.45 30.45 31.45 32.45\n",
      " 33.45]\n"
     ]
    }
   ],
   "source": [
    "# CÃ¡lculo de la amplitud\n",
    "A = round((max(cw)-min(cw))/freedman_diaconis(cw), 1)\n",
    "\n",
    "print(\"La amplitud es {}\".format(A))\n",
    "\n",
    "# Extremos de los intervalos\n",
    "L = np.zeros(freedman_diaconis(cw) + 1)\n",
    "L[0] = min(cw) - 1 / 2 * 0.1\n",
    "for i in range(1, freedman_diaconis(cw) + 1):\n",
    "    L[i] = L[0] + i * A\n",
    "\n",
    "print(\"Los intervalos son: {}\".format(L))\n",
    "# Marcas de clase\n",
    "\n",
    "X = np.zeros(freedman_diaconis(cw))\n",
    "X[0] = (L[0] + L[1])/2\n",
    "for i in range(1, freedman_diaconis(cw)):\n",
    "    X[i] = (L[i] + L[i+1])/2\n",
    "    \n",
    "print(\"Las marcas son: {}\".format(X))"
   ]
